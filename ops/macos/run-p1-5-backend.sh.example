#!/bin/zsh

# Runtime wrapper for the P1.5 FastAPI LaunchAgent.
# Copy this file without the .example suffix and keep it outside Git if edited.
# Secrets are read from macOS Keychain at process start and are never written to
# the plist, repository, logs, or command-line arguments.

set -euo pipefail

REPO_ROOT="/Users/REPLACE_WITH_ACCOUNT/Documents/Codex/telegram-ai-knowledge-collector"
VENV_PYTHON="$REPO_ROOT/.venv/bin/python"
KEYCHAIN_SERVICE_PREFIX="com.business-knowledge-capture.p1-5"
KEYCHAIN_ACCOUNT="$(/usr/bin/id -un)"

if [[ ! -x "$VENV_PYTHON" ]]; then
  print -u2 "P1.5 backend start blocked: virtualenv Python is unavailable"
  exit 78
fi

keychain_secret() {
  local account="$1"
  local value
  value="$(/usr/bin/security find-generic-password \
    -s "${KEYCHAIN_SERVICE_PREFIX}.${account}" \
    -a "$KEYCHAIN_ACCOUNT" \
    -w 2>/dev/null)" || {
      print -u2 "P1.5 backend start blocked: required Keychain item is unavailable"
      exit 78
    }
  if [[ -z "$value" ]]; then
    print -u2 "P1.5 backend start blocked: required Keychain item is empty"
    exit 78
  fi
  print -r -- "$value"
}

API_AUTH_TOKEN="$(keychain_secret api-auth-token)"
GEMINI_API_KEY="$(keychain_secret gemini-api-key)"

DATA_DIR="$HOME/Library/Application Support/business-knowledge-capture"
mkdir -p "$DATA_DIR"
chmod 700 "$DATA_DIR"

export APP_ENV=production
export AUTH_MODE=token
export API_AUTH_TOKEN
export AI_PROVIDER=gemini
export ENABLE_LIVE_AI=true
export GEMINI_MODEL=gemini-3.6-flash
export GEMINI_API_KEY
export ALLOWED_ORIGINS=https://capture.lamlab.cc,http://127.0.0.1:8000
export DATABASE_URL="sqlite:///$DATA_DIR/capture.sqlite3"

cd "$REPO_ROOT"
exec "$VENV_PYTHON" -m uvicorn backend.app:app --host 127.0.0.1 --port 8000
