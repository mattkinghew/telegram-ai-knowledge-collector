<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.business-knowledge-capture.p1-5.backend</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/REPLACE_WITH_ACCOUNT/Library/Application Support/business-knowledge-capture/run-p1-5-backend.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_WITH_ACCOUNT/Library/Application Support/business-knowledge-capture/runtime/app</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/p1-5-backend.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/p1-5-backend.stderr.log</string>
</dict>
</plist>
