{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/mobile-insight-response-v3.schema.json",
  "title": "Travel Mobile Knowledge Enrichment Response v3",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "schema_version", "result"],
      "properties": {
        "ok": {"const": true},
        "schema_version": {"const": "3"},
        "result": {"$ref": "#/$defs/enrichment_result"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error_code", "message", "quick_save_available"],
      "properties": {
        "ok": {"const": false},
        "error_code": {
          "type": "string",
          "enum": ["INVALID_REQUEST", "AI_UNAVAILABLE", "AI_TIMEOUT", "INVALID_AI_JSON", "SCHEMA_MISMATCH", "INTERNAL_ERROR"]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 200},
        "quick_save_available": {"const": true}
      }
    },
    "enrichment_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggested_title",
        "one_sentence_insight",
        "core_points",
        "why_it_matters",
        "practical_applications",
        "suggested_next_action",
        "recommended_output",
        "short_article_draft",
        "facts_to_verify",
        "missing_information",
        "related_project",
        "confidence"
      ],
      "properties": {
        "suggested_title": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "one_sentence_insight": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "core_points": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "why_it_matters": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "practical_applications": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "suggested_next_action": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "recommended_output": {
          "type": ["string", "null"],
          "enum": ["summary", "recommendation", "short_article", "project_knowledge", "task", "decision", "learning_note", null]
        },
        "short_article_draft": {"type": ["string", "null"], "minLength": 1, "maxLength": 309},
        "facts_to_verify": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "missing_information": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "related_project": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    }
  }
}
