{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/voice-capture-request-v1.schema.json",
  "title": "Universal Voice Capture Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "captured_at",
    "source_type",
    "raw_transcript",
    "allowed_projects"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "captured_at": { "type": "string", "format": "date-time", "maxLength": 64 },
    "source_type": { "const": "voice_transcript" },
    "raw_transcript": { "type": "string", "minLength": 1, "maxLength": 50000 },
    "allowed_projects": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n]+$" }
    }
  }
}
